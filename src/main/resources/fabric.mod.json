{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "Enderman & Creeper will stop their sounds when they die + Nether portal sound fix.",
  "authors": [
    "${author}"
  ],
  "contact": {
    "sources": "${repoUrl}"
  },
  "license": "MIT",
  "icon": "assets/shutupdeadentities/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.diskree.shutupdeadentities.client.ShutUpDeadEntities"
    ]
  },
  "mixins": [
    "shutupdeadentities.mixins.json"
  ],
  "depends": {
    "java": ">=${minJavaVersion}",
    "minecraft": ">=${minMinecraftVersion}",
    "fabricloader": ">=${minLoaderVersion}"
  },
  "accessWidener": "shutupdeadentities.accesswidener"
}
